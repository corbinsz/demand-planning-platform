# Copy to backend/.env for a single-brand server. Do not commit the copy.
# The demo script does not need this file.

# Database. Leave USE_SQLITE=true on a laptop. Docker sets Postgres itself.
USE_SQLITE=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/inventory_intel
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/inventory_intel

# Turn the sample brand on only for a sales demo. Turn it off before a real client.
DEMO_MODE=false
AUTO_SEED=false

# Required when DEMO_MODE is false. Use a long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Optional separate key for encrypting stored Shopify and ShipHero tokens.
# If blank, SECRET_KEY is used.
TOKEN_ENCRYPTION_KEY=

# Public URLs. Shopify redirects back to PUBLIC_APP_URL.
PUBLIC_APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Shopify app credentials (the app you create, not a store token).
# Leave blank until you are ready to let a brand click Connect.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-10

# Single-brand fallback only. Ignored when more than one workspace exists.
# Prefer Connect in the app. Never put a real token in git.
ALLOW_ENV_CREDENTIALS=false
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHIPHERO_API_TOKEN=

# Weekly email. Leave blank to keep the Monday note as an in-app preview.
# The schedule is Monday 8:00am Mountain Time (Utah).
DIGEST_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

LOG_LEVEL=INFO
SCHEDULER_ENABLED=true
WARM_FORECASTS=true
