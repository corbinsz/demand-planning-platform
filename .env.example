# Copy to .env if you want to override the defaults in docker-compose.yml.
# The committed defaults run the synthetic demo. They are not production secrets.
# Do not put a real Shopify or ShipHero token in git.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inventory_intel

# Local `uvicorn` ignores these and uses SQLite until USE_SQLITE=false.
USE_SQLITE=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inventory_intel
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/inventory_intel

# Leave these as replace-me to run the demo without calling Shopify or ShipHero.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=replace-me
SHIPHERO_API_TOKEN=replace-me

# Change this before anyone but you can reach the API.
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
LOG_LEVEL=INFO

# Docker Compose sets this true so an empty database gets the demo catalog.
SEED_ON_START=true
DISABLE_SCHEDULER=false
